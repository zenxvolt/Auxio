<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cache databases are useless between devices, drop them -->
    <cloud-backup>
        <exclude
            domain="database"
            path="music_cache.db" />
        <!-- The index of the streaming cache, whose files are never backed up -->
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- The Jellyfin access token and catalog only mean something on the device that made them -->
        <exclude
            domain="sharedpref"
            path="jellyfin.xml" />
        <exclude
            domain="file"
            path="jellyfin/" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="music_cache.db" />
        <!-- The index of the streaming cache, whose files are never backed up -->
        <exclude
            domain="database"
            path="exoplayer_internal.db" />
        <!-- The Jellyfin access token and catalog only mean something on the device that made them -->
        <exclude
            domain="sharedpref"
            path="jellyfin.xml" />
        <exclude
            domain="file"
            path="jellyfin/" />
    </device-transfer>
</data-extraction-rules>